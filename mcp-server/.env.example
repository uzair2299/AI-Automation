# Server Transport (stdio or streamable-http)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8080
LOG_LEVEL=INFO

# Kubernetes Configuration
KUBECONFIG=~/.kube/config
K8S_DEFAULT_CLUSTER=default
K8S_CLUSTERS_CONFIG=clusters.yaml

# Security & Namespace Guardrails
K8S_ALLOWED_NAMESPACES=
K8S_DENIED_NAMESPACES=kube-system-sensitive
K8S_ALLOW_CONFIGMAP_VALUES=false
K8S_DEFAULT_TIMEOUT_SECONDS=10

# Response Limits
K8S_MAX_LIST_ITEMS=200
K8S_DEFAULT_LOG_LINES=500
K8S_HARD_CAP_LOG_LINES=5000
