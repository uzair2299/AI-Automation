{
  $schema: https://railway.app/railway.schema.json,
  build: {
    builder: DOCKERFILE,
    dockerfilePath: deploy/docker/Dockerfile.api
  },
  deploy: {
    startCommand: uvicorn smiota.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 2,
    restartPolicyType: ON_FAILURE,
    restartPolicyMaxRetries: 10
  }
}
