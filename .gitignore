# ===============================
# Smiota Monorepo .gitignore
# ===============================

# --- Java / Maven ---
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- Java / Gradle (if any) ---
.gradle/
build/

# --- IDEs & Editors ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Logs & Temp ---
*.log
logs/
temp/
tmp/

# --- Environment & Secrets ---
# (Keep .env.example tracked, ignore local configs)
.env.local
.env.dev.local
.env.development.local
.env.test.local
.env.production.local
