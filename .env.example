# ==============================================================================
# Smiota Platform - Unified Monorepo Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / Common Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ------------------------------------------------------------------------------
# 2. Smiota Core API (Java / Spring Boot - Port 8080)
# ------------------------------------------------------------------------------
CORE_API_PORT=8080
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smiota_db
MYSQL_USER=smiota_user
MYSQL_PASSWORD=smiota_password
MYSQL_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Core API Security & JWT
JWT_SECRET_KEY=smsec_fc7308bef9f566733226ff8db7601fe7dc138e6f12831b9978bb307973604f3e
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. Smiota AI Platform (Python / FastAPI - Port 8000)
# ------------------------------------------------------------------------------
AI_GATEWAY_PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# GCP & Gemini LLM Settings
GCP_PROJECT_ID=project-smiota-psi-1
GCP_REGION=global
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_API_KEY=
GOOGLE_API_KEY=

# AI PostgreSQL (pgvector) & Redis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smiota_user
POSTGRES_PASSWORD=smaiops26devdb
POSTGRES_DB=smiota_ai_dev
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Model Context Protocol (MCP) & Internal Integration
MCP_REMOTE_ENABLED=true
MCP_REMOTE_FALLBACK=true
MCP_CLIENT_TIMEOUT_SECONDS=15.0
MCP_LOCKER_SERVER_URL=http://localhost:8082
RAG_SERVICE_URL=http://localhost:8001

# Connection from AI Platform to Java Core API
SMIOTA_CORE_API_URL=http://localhost:8080
SMIOTA_SERVICE_TOKEN=smsec_fc7308bef9f566733226ff8db7601fe7dc138e6f12831b9978bb307973604f3e
