# ==============================================================================
# Smiota AI Platform Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# GCP & Vertex AI
GCP_PROJECT_ID=project-smiota-psi-1
GCP_REGION=global
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database & Cache
DATABASE_URL=postgresql+asyncpg://smiota_user:password@localhost:5432/smiota_ai
REDIS_URL=redis://localhost:6379/0

# Security & Auth (OIDC / OAuth2)
JWT_SECRET_KEY=change-this-in-production-use-strong-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Context Protocol (MCP)
MCP_READ_ONLY_DEFAULT=true
REQUIRE_HUMAN_APPROVAL_FOR_REMEDIATION=true

# Telemetry & Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_PROMETHEUS_METRICS=true

# Smiota Server Integration
# NOTE: SMIOTA_SERVICE_TOKEN must be configured with a different unique secret for each environment,
# matching the Java backend 'ai.internal.service.token' property in app.properties / app.qa.properties / app.prod.properties:
# - Dev/Local:  smsec_fc7308bef9f566733226ff8db7601fe7dc138e6f12831b9978bb307973604f3e (http://localhost:8080/smiota)
# - QA/Staging: configure QA secret token (https://qa.smiotaapps.com/smiota or https://dev.smiotaapps.com/smiota)
# - Production: configure Prod secret token via Secret Manager (https://www.smiotaapps.com/smiota)
SMIOTA_SERVICE_TOKEN=smsec_replace_with_env_specific_token
SMIOTA_SERVER_BASE_URL=https://dev.smiotaapps.com/smiota
SMIOTA_AUTH_DUMMY_MODE=false

# Microsoft Teams & Bot Framework Connector
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
TEAMS_APP_ID=

# RAG Knowledge Engine & Vector Store
VECTOR_STORE_BACKEND=memory
RAG_KNOWLEDGE_DIR=data/knowledge/public
RAG_INPUT_JSONL_PATH=data/knowledge/public/website_content.jsonl


