# ==============================================================================
# Smiota AI Platform Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# GCP & Vertex AI
GCP_PROJECT_ID=smiota-cloud-prod
GCP_REGION=us-central1
GEMINI_MODEL=gemini-1.5-pro-002
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database & Cache
DATABASE_URL=postgresql+asyncpg://smiota_user:password@localhost:5432/smiota_ai
REDIS_URL=redis://localhost:6379/0

# Security & Auth (OIDC / OAuth2)
JWT_SECRET_KEY=change-this-in-production-use-strong-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Context Protocol (MCP)
MCP_READ_ONLY_DEFAULT=true
REQUIRE_HUMAN_APPROVAL_FOR_REMEDIATION=true

# Telemetry & Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_PROMETHEUS_METRICS=true
