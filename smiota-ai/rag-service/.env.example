# ==============================================================================
# Smiota RAG Knowledge Service - Environment Configuration Template
# Copy this file to .env or .env.local and configure values for your environment.
# ==============================================================================

# Core Service Configuration
SERVICE_NAME=smiota-rag-service
HOST=0.0.0.0
PORT=8001
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Embedding Provider Configuration
# Supported providers: "deterministic" (offline token hash) or "gemini" (Vertex AI text-embedding-004)
EMBEDDING_PROVIDER=deterministic
GEMINI_API_KEY=
EMBEDDING_DIMENSION=768

# Document Chunking Parameters
TARGET_CHUNK_SIZE=250
CHUNK_OVERLAP=40

# Vector Storage Engine Configuration
# Supported backends: "memory" (in-memory dict) or "pgvector" (PostgreSQL with pgvector extension)
VECTOR_STORE_BACKEND=memory
DATABASE_URL=postgresql+asyncpg://smiota_user:smaiops26devdb@localhost:5432/smiota_ai_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smiota_user
POSTGRES_PASSWORD=smaiops26devdb
POSTGRES_DB=smiota_ai_dev

# Optional External Vector Engine (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# Knowledge Seeding Limits
SEED_MAX_PAGES=50

